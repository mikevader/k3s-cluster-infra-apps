{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'mikevader/renovate-config',
  ],
  ignorePaths: [
    '.archived/**',
    '.disabled/**',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/cluster-platform-apps/renovate/.+\\.yaml$/',
    ],
  },
  customManagers: [
    {
      // Same "# renovate:" annotation syntax as the charts repo, but for any
      // YAML under cluster-*/ and for tag/appVersion/version keys, e.g.
      //   # renovate: image=ghcr.io/bank-vaults/bank-vaults
      //   tag: v1.33.2
      //   # renovate: datasource=github-releases packageName=owner/repo
      //   version: 1.2.3
      customType: 'regex',
      managerFilePatterns: [
        '/^cluster-[^/]+/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: image=(?<depName>\\S+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+(?:tag|appVersion|version):\\s?"?(?<currentValue>[\\w+\\.\\-]+?)"?\\s',
        '# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>\\S+?))? packageName=(?<packageName>\\S+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+(?:tag|appVersion|version):\\s?"?(?<currentValue>[\\w+\\.\\-]+?)"?\\s',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}',
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      addLabels: [
        'container',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'renovate/image-release',
        'dependency/major',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'renovate/image-release',
        'dependency/minor',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'renovate/image-release',
        'dependency/patch',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'renovate/helm-chart',
        'dependency/major',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'renovate/helm-chart',
        'dependency/minor',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'renovate/helm-chart',
        'dependency/patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      addLabels: [
        'automerge',
      ],
      automerge: true,
      versioning: 'loose',
      matchPackageNames: [
        '/^ghcr.io/mikevader/.*/',
        '/renovate/renovate/',
        '/oxsecurity/megalinter/',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      versioning: 'loose',
      matchPackageNames: [
        '/bitnami/external-dns/',
        '/^ghcr.io/k8s-at-home/qbittorrent/',
      ],
    },
    {
      matchFileNames: [
        'cr-raft.yaml',
      ],
      matchDatasources: [
        'docker',
      ],
      commitMessageTopic: 'Docker image {{depName}}',
      commitMessageExtra: 'to {{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      enabled: true,
      matchPackageNames: [
        '/vault/',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'automerge',
      ],
      automerge: true,
      matchPackageNames: [
        '/argo-cd/',
        '/plex/',
        '/dmw/',
      ],
    },
  ],
}
