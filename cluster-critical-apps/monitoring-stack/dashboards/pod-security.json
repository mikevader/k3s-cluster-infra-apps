    },
    {
      "type": "table",
      "id": 15,
      "title": "Requests denied by enforce",
      "description": "Requests rejected with 'violates PodSecurity'. For controller-created pods the user is the controller service account (e.g. replicaset-controller).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (namespace, resource, user, reason) (count_over_time({job=\"k3s-audit\", namespace=~\"$namespace\"} |= \"violates PodSecurity\" | json resource=\"objectRef.resource\", user=\"user.username\", reason=\"responseStatus.message\" [$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "resource": 1,
              "user": 2,
              "reason": 3,
              "Value #A": 4
            },
            "renameByName": {
              "namespace": "Namespace",
              "resource": "Resource",
              "user": "User",
              "reason": "Reason",
              "Value #A": "Denied"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reason"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              },
              {
                "id": "custom.width",
                "value": 900
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      }
    },
    {
